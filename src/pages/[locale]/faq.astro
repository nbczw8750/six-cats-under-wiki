---
/**
 * FAQ category list page (non-default locales, e.g. /zh/faq).
 *
 * Mirrors src/pages/faq.astro — the same category-list rendering as every
 * other content type (see there for why this route exists). Default locale
 * is handled by src/pages/faq.astro because `prefixDefaultLocale: false`.
 */
import ListPage from '~/components/article/ListPage.astro';
import { localesForCategory } from '~/lib/content';
import { isLocale, defaultLocale, locales, type Locale } from '~/i18n/routing';
import { languageAlternates, listPath } from '~/lib/url';

export function getStaticPaths() {
  // Only non-default locales — default is at /faq.
  // `locales` is a module-level export (visible inside getStaticPaths,
  // unlike same-file top-level const — see AGENTS.md Astro 5 gotcha #3).
  return locales
    .filter((l) => l !== defaultLocale)
    .map((l) => ({ params: { locale: l } }));
}

const { locale: localeParam } = Astro.params;
if (!isLocale(localeParam) || localeParam === defaultLocale) {
  return Astro.redirect('/faq');
}
const locale: Locale = localeParam;
const category = 'faq';
const listLocales = await localesForCategory(category);
const alternates = languageAlternates((loc) => listPath(category, loc), listLocales);
---

<ListPage locale={locale} category={category} alternates={alternates} />

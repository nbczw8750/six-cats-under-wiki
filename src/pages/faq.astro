---
/**
 * FAQ category list page (default locale, /faq).
 *
 * `faq` is a content category in NAVIGATION_CONFIG, so /faq must render the
 * same category list as every other content type. This route previously
 * rendered a standalone accordion from locale JSON `home.faq` — with `faq`
 * selected as a navigation category that page shadowed the category list
 * from [...slug].astro, leaving wiki FAQ articles unreachable from any list.
 * It now renders ListPage directly, mirroring the [...slug] list branch.
 */
import ListPage from '~/components/article/ListPage.astro';
import { localesForCategory } from '~/lib/content';
import { defaultLocale } from '~/i18n/routing';
import { languageAlternates, listPath } from '~/lib/url';

const locale = defaultLocale;
const category = 'faq';
const listLocales = await localesForCategory(category);
const alternates = languageAlternates((loc) => listPath(category, loc), listLocales);
---

<ListPage locale={locale} category={category} alternates={alternates} />
